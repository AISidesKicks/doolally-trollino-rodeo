# pixi environments
.pixi/*
!.pixi/config.toml

# scratch artifacts
scratch/*
!scratch/.gitkeep

# generated datasets: the canonical JSONL and manifest are tracked,
# the CSV view and parquet intermediates stay local
datasets/*.csv
datasets/*.parquet
.cache/

# node
node_modules/

# python
__pycache__/
*.py[cod]

# local environment files
.env
.env.*
!.env.example

# model weights, only the placeholder stays tracked
models/*
!models/.gitkeep
